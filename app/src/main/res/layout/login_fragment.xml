<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:layout_gravity="center"
    tools:context=".ui.login.LoginFragment">

    <!-- Form Container -->
    <LinearLayout
        android:id="@+id/formContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:padding="16dp"
        android:background="?attr/colorSurface"
        android:elevation="1dp"
        android:clipToPadding="false"
        android:visibility="visible">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvAuthTitle"
            android:text="Login"
            android:textSize="22sp"
            android:textAllCaps="true"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"
            />

        <!-- Email Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailInputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:layout_marginHorizontal="12dp"
            app:hintTextColor="?attr/colorOnSurface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordInputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="12dp"
            android:hint="Password"
            app:endIconMode="password_toggle"
            app:endIconScaleType="centerInside"
            app:hintTextColor="?attr/colorOnSurface">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>
        <!-- Re-Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordInputLayout1"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="12dp"
            android:hint="Re-type Password"
            android:paddingEnd="16dp"
            app:endIconMode="password_toggle"
            app:hintTextColor="?attr/colorOnSurface"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:id="@+id/passwordChecklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRuleLength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ Minimum 8 characters"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRuleLower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ At least one lowercase letter"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRuleUpper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ At least one uppercase letter"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRuleDigit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ At least one digit"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRuleSpecial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌ At least one special character (!@#$...)"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Forgot Password -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot Password?"
            android:textColor="?attr/colorPrimary"
            android:layout_gravity="end"
            android:paddingTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
        <!-- Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/GoogleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login"
            android:textColor="?attr/colorOnPrimary"
            android:backgroundTint="?attr/colorPrimary"
            android:elevation="8dp"
            android:layout_marginHorizontal="4dp"/>
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:layout_marginHorizontal="24dp"
                />

        <!-- Google Sign-In -->
        <Button
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            style="@style/GoogleButton"
            android:layout_height="wrap_content"
            android:text="Google"
            android:drawableLeft="@drawable/ic_google"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            />
        </LinearLayout>
        <!-- Auth Toggle -->
        <TextView
            android:id="@+id/tvToggleAuthMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an account? Sign up"
            android:textColor="?attr/colorOnSurface"
            android:layout_gravity="center"
            android:paddingTop="16dp" />

        <!-- Guest Mode -->
        <TextView
            android:id="@+id/tvGuestMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continue as Guest"
            android:textColor="?attr/colorPrimary"
            android:layout_gravity="center"
            android:paddingTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"/>
    </LinearLayout>
    <!-- Email verification  -->
    <com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        android:padding="24dp"
        android:layout_centerInParent="true"
        android:background="?attr/colorSurface"
        android:visibility="gone"
        android:id="@+id/emailVerificationPopup">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:gravity="center">


            <TextView
                android:id="@+id/tvVerifyInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please verify your email address to continue."
                android:textAlignment="center"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="36dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvEmailToVerify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="user@example.com"
                android:textStyle="bold"
                android:textColor="@color/gray"
                android:textSize="14sp"
                android:layout_margin="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifyNow"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resend Verification Email"
                app:cornerRadius="8dp"
                app:iconTint="@android:color/white"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckAgain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check Again"
                app:cornerRadius="8dp"
                android:textColor="?attr/colorOnSurface"
                android:backgroundTint="@android:color/transparent"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvCooldown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You can resend after 30s"
                android:textAlignment="center"
                android:textSize="12sp"
                android:textColor="@android:color/holo_red_dark"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvGoBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back to Login"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:layout_margin="16dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


</FrameLayout>
