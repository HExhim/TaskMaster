<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.task.logs.TaskLogFragment">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayout">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sort by:"
            android:labelFor="@+id/sort_spinner"/>

        <Spinner
            android:id="@+id/sort_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Source:"
            android:labelFor="@+id/source_filter_spinner"
            android:layout_marginStart="16dp"/>

        <Spinner
            android:id="@+id/source_filter_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/controls_container"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android.src="@drawable/ic_none" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Logs Yet"
            android:textAppearance="?attr/textAppearanceHeadline6"/>

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fab_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">

        <!-- Manual FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_manual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:fabSize="mini"
            android:visibility="invisible"
            app:srcCompat="@drawable/ic_edit_note"
            app:layout_constraintBottom_toTopOf="@id/fabAddLog"
            app:layout_constraintStart_toStartOf="@id/fabAddLog"
            app:layout_constraintEnd_toEndOf="@id/fabAddLog"/>

        <TextView
            android:id="@+id/label_manual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manual"
            android:visibility="invisible"
            android:padding="8dp"
            android:labelFor="@id/fab_manual"
            app:layout_constraintTop_toTopOf="@id/fab_manual"
            app:layout_constraintBottom_toBottomOf="@id/fab_manual"
            app:layout_constraintEnd_toStartOf="@id/fab_manual"
            android:layout_marginEnd="16dp"/>

        <!-- Pomodoro FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_pomodoro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:fabSize="mini"
            android:visibility="invisible"
            app:srcCompat="@drawable/ic_pomodoro"
            app:layout_constraintBottom_toTopOf="@id/fab_manual"
            app:layout_constraintStart_toStartOf="@id/fabAddLog"
            app:layout_constraintEnd_toEndOf="@id/fabAddLog"/>

        <TextView
            android:id="@+id/label_pomodoro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pomodoro"
            android:visibility="invisible"
            android:padding="8dp"
            android:labelFor="@id/fab_pomodoro"
            app:layout_constraintTop_toTopOf="@id/fab_pomodoro"
            app:layout_constraintBottom_toBottomOf="@id/fab_pomodoro"
            app:layout_constraintEnd_toStartOf="@id/fab_pomodoro"
            android:layout_marginEnd="16dp"/>

        <!-- Stopwatch FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_stopwatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:fabSize="mini"
            android:visibility="invisible"
            app:srcCompat="@drawable/ic_stopwatch"
            app:layout_constraintBottom_toTopOf="@id/fab_pomodoro"
            app:layout_constraintStart_toStartOf="@id/fabAddLog"
            app:layout_constraintEnd_toEndOf="@id/fabAddLog"/>

        <TextView
            android:id="@+id/label_stopwatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stopwatch"
            android:visibility="invisible"
            android:padding="8dp"
            android:labelFor="@id/fab_stopwatch"
            app:layout_constraintTop_toTopOf="@id/fab_stopwatch"
            app:layout_constraintBottom_toBottomOf="@id/fab_stopwatch"
            app:layout_constraintEnd_toStartOf="@id/fab_stopwatch"
            android:layout_marginEnd="16dp"/>


        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_add"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>