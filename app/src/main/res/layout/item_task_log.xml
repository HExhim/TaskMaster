<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:strokeWidth="0dp"
    app:cardElevation="2dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:id="@+id/cardRoot"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            >

            <TextView
                android:id="@+id/logDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/LogTimeText"
                tools:text="1h 25m"/>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:background="?attr/colorOutline"/>

            <TextView
                android:id="@+id/logDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/LogDetailText"
                tools:text="Jun 14, 2023"/>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:background="?attr/colorOutline"/>

            <TextView
                android:id="@+id/logTimeRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/LogDetailText"
                tools:text="10:30 AM - 11:55 AM"/>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:background="?attr/colorOutline"/>

        </LinearLayout>

        <TextView
            android:id="@+id/logNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/LogDetailText"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Worked on implementing the analytics dashboard UI components"/>

        <TextView
            android:id="@+id/logSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/blue_800"
            tools:text="Source:"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>