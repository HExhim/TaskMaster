<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="?attr/colorSurface"
    android:clipToPadding="false">

    <!-- Date Range Section -->
    <TextView
        android:id="@+id/lblDateRange"
        android:text="Date Range"
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no" />

    <RadioGroup
        android:id="@+id/radioGroupDateRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioAll"
            android:text="All"
            android:checked="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioToday"
            android:text="Today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioWeek"
            android:text="This Week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radioMonth"
            android:text="This Month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </RadioGroup>

    <!-- Status Section -->
    <TextView
        android:id="@+id/lblStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status"
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkCompleted"
            android:text="Completed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkIncomplete"
            android:text="Incomplete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <!-- Source Section -->
    <TextView
        android:id="@+id/lblSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Source"
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/chkStopwatch"
            android:text="StopWatch"/>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/chkPomodoro"
            android:text="Pomodoro"/>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/chkFocusSession"
            android:text="Focus Session"/>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/chkManual"
            android:text="Manual"/>
    </LinearLayout>


    <!-- Action Buttons -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="end"
        android:paddingTop="8dp"
        android:showDividers="middle"
        android:divider="@drawable/divider_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            android:text="Reset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="96dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:text="Apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minWidth="96dp"
            style="@style/Widget.Material3.Button.IconButton.Filled" />
    </LinearLayout>
</LinearLayout>